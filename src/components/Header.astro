---
const nav = [
  { label: 'About', href: '/#about' },
  { label: 'Research', href: '/#research' },
  { label: 'Skills & Languages', href: '/#capabilities' },
  { label: 'Publications', href: '/#publications' },
  { label: 'Certificates', href: '/#certificates' },
  { label: 'Projects', href: '/#projects' },
];

const external = [
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=y76Kz1oAAAAJ' },
  { label: 'ORCID', href: 'https://orcid.org/0000-0003-1465-6468' },
  { label: 'GitHub', href: 'https://github.com/kingwatam' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kingwatam' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label="Home">KING WA TAM</a>
    <nav aria-label="Main" class="main-nav">
      <ul class="nav-list">
        {nav.map(item => (
          <li><a href={item.href} class="tab">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <ul class="external-links" aria-label="External profiles">
      {external.map(item => (
        <li>
          <a href={item.href} target="_blank" rel="noopener me" class="ext-link">{item.label}<span class="ext-arrow" aria-hidden="true">&#8599;</span></a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-paper);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: 0.85rem;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .nav-list {
    display: flex;
    list-style: none;
    flex-wrap: nowrap;
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
  }

  .nav-list li {
    white-space: nowrap;
  }

  .tab,
  .ext-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink-muted);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .tab:hover,
  .ext-link:hover {
    color: var(--ink);
  }

  .ext-arrow {
    font-size: 0.65em;
    margin-left: 2px;
    vertical-align: super;
    opacity: 0.7;
  }

  /* External profiles: pinned far right with a guaranteed wide channel
     between tabs and URLs */
  .external-links {
    display: flex;
    list-style: none;
    gap: 1rem;
    margin-left: auto;
    padding-left: clamp(3rem, 10vw, 8rem);
  }

  @media (max-width: 1200px) {
    .external-links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      padding-block: 0.65rem;
    }

    .nav-list {
      flex-wrap: wrap;
      gap: 0.4rem 0.9rem;
    }
  }
</style>
