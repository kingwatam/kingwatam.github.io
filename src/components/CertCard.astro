---
interface Course {
  id: string;
  title: string;
  date?: string | null;
  pdf: string;
}

interface Props {
  cert: {
    id: string;
    title: string;
    issuer: string;
    isSpecialization: boolean;
    date?: string | null;
    pdf?: string;
    courses?: Course[];
  };
}

const { cert } = Astro.props;

const fmt = (iso?: string | null) => {
  if (!iso) return '';
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
};
---

{cert.isSpecialization ? (
  <details class="cert-group">
    <summary class="cert-group-header">
      <span class="cert-group-title">
        {cert.title}
        <span class="cert-group-meta"> · {cert.issuer}{fmt(cert.date) ? ` · ${fmt(cert.date)}` : ''}</span>
      </span>
      <span class="cert-group-toggle" aria-hidden="true">+</span>
    </summary>
    <div class="cert-courses">
      {cert.pdf && (
        <a
          id={`pdf-${cert.id}`}
          href={cert.pdf}
          target="_blank"
          rel="noopener"
          class="cert-course spec-cert"
          data-pdf
          data-title={`${cert.title} — specialization certificate`}
          aria-expanded="false"
        >
          <span>Specialization certificate</span>
          <span class="cert-course-date">{fmt(cert.date)}</span>
        </a>
      )}
      {cert.courses?.map(course => (
        <a
          id={`pdf-${course.id}`}
          href={course.pdf}
          target="_blank"
          rel="noopener"
          class="cert-course sub"
          data-pdf
          data-title={`${course.title} — ${cert.issuer}`}
          aria-expanded="false"
        >
          <span>{course.title}</span>
          <span class="cert-course-date">{fmt(course.date)}</span>
        </a>
      ))}
    </div>
  </details>
) : (
  <a
    id={`pdf-${cert.id}`}
    href={cert.pdf}
    target="_blank"
    rel="noopener"
    class="cert-standalone"
    data-pdf
    data-title={`${cert.title} — ${cert.issuer}`}
    aria-expanded="false"
  >
    <span>
      <span class="cert-group-title">{cert.title}</span>
      <span class="cert-group-meta"> · {cert.issuer}</span>
    </span>
    <span class="cert-course-date">{fmt(cert.date)}</span>
  </a>
)}

<style>
  .cert-group-title {
    font-weight: 500;
  }

  .cert-group-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .cert-course-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
</style>
