---
interface Props {
  pub: {
    id: string;
    title: string;
    authors: string[];
    journal: string;
    year: number;
    doi: string;
    myRole: string;
  };
}

const { pub } = Astro.props;

function renderAuthors(authors: string[], role: string): string {
  return authors
    .map(a => {
      const clean = a.replace(/\^/g, '');
      const isOwn = /^Tam K(W)?$/.test(clean);
      if (!isOwn) return clean;
      const cofirst = role === 'cofirst';
      return `<strong>${clean}</strong>${cofirst ? '<sup class="pub-cofirst" aria-label="co-first author">^</sup>' : ''}`;
    })
    .join(', ');
}
---

<a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" class="pub-row">
  <span class="pub-year">{pub.year}</span>
  <span class="pub-main">
    <span class="pub-title">{pub.title}</span>
    <span class="pub-authors" set:html={renderAuthors(pub.authors, pub.myRole)} />
  </span>
  <span class="pub-journal">{pub.journal}</span>
</a>
