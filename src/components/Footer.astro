---
const year = new Date().getFullYear();

const links = [
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=y76Kz1oAAAAJ' },
  { label: 'ORCID', href: 'https://orcid.org/0000-0003-1465-6468' },
  { label: 'GitHub', href: 'https://github.com/kingwatam' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kingwatam' },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copy">&copy; {year} King Wa Tam</p>
    <ul class="footer-links">
      {links.map(link => (
        <li><a href={link.href} target="_blank" rel="noopener me">{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .footer-links {
    margin-left: auto;
  }
</style>
