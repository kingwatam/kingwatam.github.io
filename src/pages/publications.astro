---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PubRow from '../components/PubRow.astro';
import publications from '../data/publications.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Publications",
  "description": "Peer-reviewed publications by King Wa Tam, PhD — epidemiology, health economics, and cancer research.",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": publications.length,
    "itemListElement": publications.map((pub, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "ScholarlyArticle",
        "headline": pub.title,
        "datePublished": pub.year.toString(),
        "author": pub.authors.map(a => ({
          "@type": "Person",
          "name": a.replace(/\^$/, '')
        })),
        "isPartOf": {
          "@type": "Periodical",
          "name": pub.journal
        },
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "DOI",
          "value": pub.doi
        },
        "url": `https://doi.org/${pub.doi}`
      }
    }))
  }
};
---

<BaseLayout
  title="Publications"
  description="12 peer-reviewed publications in epidemiology, health economics, and cancer research — PLOS Medicine, BMC Geriatrics, Frontiers in Oncology, and more."
  jsonLd={jsonLd}
>
  <section class="section" style="border-top: none;">
    <div class="container">
      <a href="/#publications" class="back-link"><span aria-hidden="true">&#8592;</span> Back</a>
      <SectionHeading kicker="Publications" />
      <p style="max-width: 42rem; margin-bottom: 2rem; color: var(--ink-muted);">
        {publications.length} peer-reviewed publications · co-first author indicated by{' '}
        <sup class="pub-cofirst pub-cofirst--legend">^</sup>.
      </p>
      <div class="pub-list">
        {publications.map(pub => (
          <PubRow pub={pub} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pub-list {
    display: flex;
    flex-direction: column;
  }
</style>
